@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
HIDE_STEREOTYPE()

title E-Commerce API Server - Component

Container_Boundary(api_server, "API Server") {
  Component(auth_controller, "AuthController", "Controller", "Handles login and logout requests")
  Component(product_controller, "ProductController", "Controller", "Handles product CRUD operations")
  Component(order_controller, "OrderController", "Controller", "Handles order management")
  Component(auth_service, "AuthService", "Service", "Validates tokens and manages authentication")
  ComponentDb(product_repository, "Product Repository", "Repository", "Data access layer backed by PostgreSQL")
  ComponentDb(order_repository, "Order Repository", "Repository", "Data access layer backed by PostgreSQL")
}

ContainerDb_Ext(postgresql_db, "PostgreSQL Database", "PostgreSQL", "Stores all application data")

Rel(auth_controller, auth_service, "Delegates auth logic", "Internal")
Rel(product_controller, product_repository, "Reads/writes products", "Internal")
Rel(order_controller, order_repository, "Reads/writes orders", "Internal")
Rel(product_repository, postgresql_db, "Queries", "SQL/JDBC")
Rel(order_repository, postgresql_db, "Queries", "SQL/JDBC")

@enduml
