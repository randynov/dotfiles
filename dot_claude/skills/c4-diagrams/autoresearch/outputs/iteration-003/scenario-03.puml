@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
HIDE_STEREOTYPE()

title Ride-Sharing Platform - Context

Person(rider, "Rider", "Requests rides through the platform")
Person(driver, "Driver", "Accepts ride requests through the platform")
System(ride_sharing, "Ride-Sharing Platform", "Connects riders and drivers for on-demand transportation")
System_Ext(maps_service, "Google Maps Service", "Provides routing and navigation")
System_Ext(payment_service, "Payment Service (Stripe)", "Processes ride payments")
System_Ext(notification_service, "Push Notification Service (Firebase)", "Sends push notifications to users")
System(support_system, "Support Agent System", "Handles dispute resolution between riders and drivers")

Rel(rider, ride_sharing, "Requests rides", "Mobile/Web")
Rel(driver, ride_sharing, "Accepts rides", "Mobile")
Rel(ride_sharing, maps_service, "Gets routing", "API")
Rel(ride_sharing, payment_service, "Processes payments", "API")
Rel(ride_sharing, notification_service, "Sends notifications", "API")
Rel(support_system, ride_sharing, "Manages disputes", "API")

@enduml
