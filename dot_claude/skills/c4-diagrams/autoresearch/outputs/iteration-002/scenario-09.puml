@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Sequence.puml
HIDE_STEREOTYPE()

title User Login Flow - Sequence Diagram

Person(user, "User", "A user of the web application")
Container(web_app, "Web Application", "React", "Frontend web application")
Container(api_server, "API Server", "Node.js", "Backend API server")
ContainerDb(database, "Database", "PostgreSQL", "Stores user credentials and data")

== Authentication ==
Rel(user, web_app, "Submits credentials", "HTTPS")
Rel(web_app, api_server, "POST /auth/login", "REST/JSON")
Rel(api_server, database, "Queries password hash", "SQL")
Rel(database, api_server, "Returns user record", "SQL")
Rel(api_server, web_app, "Returns JWT token", "REST/JSON")
Rel(web_app, user, "Redirects to dashboard", "Browser")

@enduml
