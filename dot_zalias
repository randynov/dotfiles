# Create worktree from GitHub issue (accepts URL or issue number)
giw() {
  # Cleanup function
  [[ "$1" =~ ^-c ]] && {
    local issue=$2
    [ -z "$issue" ] && { echo "Usage: giw -c <issue-number>"; return 1 }

    local dir="../mqol-$issue"

    if [ ! -d "$dir" ]; then
      echo "❌ Worktree folder not found: $dir"

      # Check for any branches with this issue number
      echo "🔍 Checking for branches with issue #$issue..."
      git branch --list | grep -i "$issue" | while read branch; do
        branch=$(echo "$branch" | sed 's/^\*\? //')  # Clean branch name
        echo "   Found branch: $branch"
        echo "   Delete with: git branch -D $branch"
      done

      return 1
    fi

    echo "🧹 Cleaning up issue #$issue..."

    # Check if we're inside the worktree
    if [[ "$(realpath "$(pwd)" 2>/dev/null)" == "$(realpath "$dir" 2>/dev/null)" ]]; then
      echo "❌ You're inside the worktree: $dir"
      echo "   Navigate out first: cd .."
      echo "   Then run: giw -c $issue"
      return 1
    fi

    # Get branch name from worktree
    local branch=""
    if [ -d "$dir/.git" ]; then
      branch=$(cd "$dir" && git branch --show-current 2>/dev/null)
    fi

    echo "📁 Removing: $dir"
    echo "🌿 Branch: ${branch:-unknown}"

    # Remove worktree
    if git worktree remove "$dir" 2>/dev/null; then
      echo "✅ Worktree removed"
    else
      echo "⚠️  Normal remove failed, trying force..."
      git worktree remove "$dir" --force 2>/dev/null || {
        echo "❌ Force remove also failed"
        echo "   Try manual removal: rm -rf $dir"
        return 1
      }
    fi

    # Delete branch if it exists
    if [ -n "$branch" ] && git show-ref --verify --quiet "refs/heads/$branch" 2>/dev/null; then
      echo "🗑️  Deleting branch: $branch"
      git branch -D "$branch" 2>/dev/null && echo "✅ Branch deleted" || echo "⚠️  Could not delete branch"
    fi

    echo "✅ Cleanup complete"
    return 0
  }

  # Help
  [[ "$1" =~ ^-h ]] && {
    echo "giw <issue>          # Create worktree for issue"
    echo "giw -c <issue>       # Cleanup worktree for issue"
    return
  }

  # Main logic - CREATE worktree
  local issue=$1
  [ -z "$issue" ] && { echo "Usage: giw <issue-number>"; return 1 }

  # ---- STEP 1: FAST FAIL - Check if worktree folder exists ----
  local dir="../mqol-$issue"

  if [ -d "$dir" ]; then
    echo "❌ FAST FAIL: Worktree folder already exists: $dir"
    echo ""

    # Provide diagnostic info
    if [ -d "$dir/.git" ]; then
      local existing_branch=$(cd "$dir" && git branch --show-current 2>/dev/null)
      echo "📊 Diagnostic info:"
      echo "   Current branch: ${existing_branch:-unknown}"
      echo "   Full path: $(realpath "$dir" 2>/dev/null)"

      # Check if we're inside it
      if [[ "$(realpath "$(pwd)" 2>/dev/null)" == "$(realpath "$dir" 2>/dev/null)" ]]; then
        echo "   ⚠️  YOU ARE CURRENTLY INSIDE THIS WORKTREE"
      fi
    else
      echo "⚠️  Folder exists but is not a git worktree"
    fi

    echo ""
    echo "🔧 To fix:"
    echo "   Clean it up: giw -c $issue"
    echo "   Or navigate to it: cd $dir"
    return 1
  fi

  # ---- STEP 2: Get repo info ----
  local repo=$(gh repo view --json nameWithOwner -q '.nameWithOwner' 2>/dev/null)
  [ -z "$repo" ] && { echo "❌ Not in a git repository"; return 1 }

  echo "🎯 Creating worktree for issue #$issue in $repo"

  # ---- STEP 3: Get issue content ----
  local content=$(gh issue view $issue --repo $repo 2>/dev/null)
  if [ -z "$content" ]; then
    echo "❌ Could not fetch issue #$issue"
    echo "   Check: https://github.com/$repo/issues/$issue"
    echo "   Or authenticate: gh auth login"
    return 1
  fi

  # ---- STEP 4: Get branch name from Gemini ----
  echo "🤖 Getting branch name from Gemini..."
  local gemini_output=$(echo "$content" | gemini \
    --prompt "Return ONLY a git branch name in format type/kebab-case for this issue.
    Example: feat/add-new-feature or fix/login-bug")

  # Extract branch name
  local branch
  if [[ "$gemini_output" =~ ([a-z]+/[a-z0-9-]+) ]]; then
    branch="${match[1]}"
  else
    branch="feat/issue-$issue"
  fi

  echo "✅ Gemini suggests: $branch"

  # ---- STEP 5: Check if branch already exists ----
  if git show-ref --verify --quiet "refs/heads/$branch" 2>/dev/null; then
    echo ""
    echo "❌ BRANCH CONFLICT: '$branch' already exists!"

    # Check if branch is used by any worktree
    local worktree_info=$(git worktree list | grep "\[$branch\]")
    if [ -n "$worktree_info" ]; then
      echo "   ⚠️  This branch is being used by a worktree:"
      echo "   $worktree_info"
    else
      echo "   ℹ️  Branch exists but is not currently used by any worktree"
    fi

    # Check if this might be from a previous attempt at this issue
    if [[ "$branch" == "feat/issue-$issue" ]] || [[ "$branch" =~ $issue ]]; then
      echo ""
      echo "🔧 This looks like a leftover branch from issue #$issue"
      echo "   You can safely delete it: git branch -D $branch"
      echo "   Then run: giw $issue"
    else
      echo ""
      echo "🔧 Options:"
      echo "   1. Delete this branch: git branch -D $branch"
      echo "   2. Use a different branch name manually"
      echo "   3. Check why this branch exists first"
    fi

    return 1
  fi

  # ---- STEP 6: Create worktree ----
  echo ""
  echo "📁 Creating worktree..."
  git worktree add -b "$branch" "$dir" main || {
    echo "❌ Failed to create worktree"
    echo "   Check if 'main' exists: git branch -a | grep main"
    return 1
  }

  cd "$dir"
  echo "✅ Created in: $(pwd)"

  # Setup mise
  [ -f "mise.toml" ] && { mise trust 2>/dev/null; echo "🔧 mise trusted" }

  echo ""
  echo "🚀 READY TO WORK ON ISSUE #$issue"
  echo "🌿 Branch: $(git branch --show-current)"
  echo "📁 Location: $(pwd)"
  echo "🔗 Issue: https://github.com/$repo/issues/$issue"

  # Show issue title
  local issue_title=$(echo "$content" | head -1)
  echo "📝 Issue: $issue_title"
}

