# Update all ollama models
pull_ollama() {
    echo "📋 Listing installed ollama models..."
    ollama list
    echo ""

    echo "🔄 Updating all models..."
    local models=$(ollama list | tail -n +2 | awk '{print $1}' | grep -v '^$')

    if [ -z "$models" ]; then
        echo "❌ No models found to update"
        return 1
    fi

    local count=0
    local total=$(echo "$models" | wc -l | tr -d ' ')

    echo "$models" | while read -r model; do
        if [ -n "$model" ]; then
            count=$((count + 1))
            echo ""
            echo "🔄 [$count/$total] Updating: $model"
            ollama pull "$model"
            echo "✅ Completed: $model"
        fi
    done

    echo ""
    echo "🎉 All ollama models updated successfully!"
}

