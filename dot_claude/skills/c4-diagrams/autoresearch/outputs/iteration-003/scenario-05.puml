@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
HIDE_STEREOTYPE()

title Real-Time Chat Application - Container

Person(user, "User", "Sends and receives messages in real-time")

System_Boundary(chat_app, "Chat Application") {
  Container(angular_spa, "Angular SPA", "Angular", "Browser-based chat frontend")
  Container(websocket_server, "WebSocket Server", "Go", "Manages real-time WebSocket connections")
  ContainerQueue(rabbitmq_broker, "RabbitMQ Message Broker", "RabbitMQ", "Routes messages between services")
  Container(message_processor, "Message Processor", "Python", "Processes and persists chat messages")
  ContainerDb(cassandra_db, "Cassandra Database", "Cassandra", "Stores message history")
}

System_Ext(oauth_service, "OAuth2 Service", "Authenticates users via OAuth2")

Rel(user, angular_spa, "Uses", "HTTPS")
Rel(angular_spa, websocket_server, "Sends/receives messages", "WebSocket")
Rel(angular_spa, oauth_service, "Authenticates", "OAuth2")
Rel(websocket_server, rabbitmq_broker, "Publishes messages", "AMQP")
Rel(message_processor, rabbitmq_broker, "Consumes messages", "AMQP")
Rel(message_processor, cassandra_db, "Stores messages", "CQL")

@enduml
